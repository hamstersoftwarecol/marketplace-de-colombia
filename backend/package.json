{
  "name": "marketplace-api",
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute marketplace-db --file=src/db/schema.sql",
    "db:seed": "wrangler d1 execute marketplace-db --file=src/db/seed.sql",
    "db:migrate:local": "wrangler d1 execute marketplace-db --local --file=src/db/schema.sql",
    "db:seed:local": "wrangler d1 execute marketplace-db --local --file=src/db/seed.sql",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.95.0"
  },
  "allowScripts": {
    "esbuild@0.17.19": true,
    "esbuild@0.21.5": true,
    "workerd@1.20241230.0": true,
    "workerd@1.20250718.0": true,
    "sharp@0.33.5": true
  }
}
